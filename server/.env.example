# Copier ce fichier en .env puis adapter les valeurs.

# --- MQTT : doit être identique à ce qui est configuré dans sketch.ino ---
MQTT_ENABLED=true
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_BASE=forestfireguard/souhir-ayari

# --- Firebase : mettre true après avoir placé serviceAccountKey.json dans server/ ---
USE_FIREBASE=false
FIREBASE_CREDENTIALS=serviceAccountKey.json

# --- Modèle IA (créé par : python ml/train_model.py) ---
MODEL_PATH=ml/model.joblib

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
